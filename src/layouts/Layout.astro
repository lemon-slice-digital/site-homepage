---
interface Props {
	title?: string;
}

const { title = "lemon slice digital - Slicing Through Complexity" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <title>{title}</title>
    <meta charset="utf-8">
    <!--[if IE]>
    <meta http-equiv='X-UA-Compatible' content='IE=edge,chrome=1'><![endif]-->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <!-- Favicons -->
    <link rel="shortcut icon" href="/images/favicon.png">

    <!-- CSS -->
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/style-responsive.css">
    <link rel="stylesheet" href="/css/vertical-rhythm.min.css">
    <link rel="stylesheet" href="/css/magnific-popup.css">
    <link rel="stylesheet" href="/css/owl.carousel.css">
    <link rel="stylesheet" href="/css/animate.min.css">
    <link rel="stylesheet" href="/css/splitting.css">
    <script async src="https://stats.lemonslice.de/script.js"
            data-website-id="d52fe82a-9d6e-4c28-b2a2-2d618ebce72e"></script>
</head>
<body class="appear-animate">

<!-- Page Loader -->
<div class="page-loader">
    <div class="loader">Loading...</div>
</div>
<!-- End Page Loader -->

<!-- Skip to Content -->
<a href="#main" class="btn skip-to-content">Skip to Content</a>
<!-- End Skip to Content -->

<!-- Page Wrap -->
<div class="page" id="top">
    <slot />
</div>
<!-- End Page Wrap -->

<!-- JS -->
<script is:inline src="/js/jquery.min.js"></script>
<script is:inline src="/js/jquery.easing.1.3.js"></script>
<script is:inline src="/js/bootstrap.bundle.min.js"></script>
<script is:inline src="/js/SmoothScroll.js"></script>
<script is:inline src="/js/jquery.scrollTo.min.js"></script>
<script is:inline src="/js/jquery.localScroll.min.js"></script>
<script is:inline src="/js/jquery.viewport.mini.js"></script>
<script is:inline src="/js/jquery.parallax-1.1.3.js"></script>
<script is:inline src="/js/jquery.fitvids.js"></script>
<script is:inline src="/js/owl.carousel.min.js"></script>
<script is:inline src="/js/isotope.pkgd.min.js"></script>
<script is:inline src="/js/imagesloaded.pkgd.min.js"></script>
<script is:inline src="/js/jquery.magnific-popup.min.js"></script>
<script is:inline src="/js/masonry.pkgd.min.js"></script>
<script is:inline src="/js/jquery.lazyload.min.js"></script>
<script is:inline src="/js/wow.min.js"></script>
<script is:inline src="/js/morphext.js"></script>
<script is:inline src="/js/typed.min.js"></script>
<script is:inline src="/js/all.js"></script>
<script is:inline src="/js/contact-form.js"></script>
<script is:inline src="/js/jquery.ajaxchimp.min.js"></script>
<script is:inline src="/js/objectFitPolyfill.min.js"></script>
<script is:inline src="/js/splitting.min.js"></script>

</body>
</html>
