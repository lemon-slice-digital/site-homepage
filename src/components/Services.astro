<!-- Services Section -->
<section class="page-section bg-lemon" id="services">
    <div class="container relative">

        <div class="text-center mb-80 mb-sm-50">
            <h2 class="section-title">Our Services</h2>
            <p class="section-title-descr">
                Digital Excellence and Fresh Perspectives
            </p>
        </div>

        <!-- Services Grid -->
        <div class="row services-grid">

            <!-- Services Item -->
            <div class="col-sm-6 col-md-4 col-lg-4">
                <div class="services-item text-center wow fadeIn" data-wow-delay="0" data-wow-duration="1.5s">
                    <div class="services-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                             fill="currentColor" aria-hidden="true" focusable="false">
                            <path d="M11 1h2v22h-2v-11h-8l-3-3 3-3h8v-5zm13 5l-3-3h-7v6h7l3-3zm-10 5v4h6l2-2-2-2h-6z"/>
                        </svg>
                    </div>
                    <h3 class="services-title">Mentor Digital <span class="marker">Strategy</span></h3>
                    <div class="services-descr">
                        We offer expert advisory, explore innovative technologies, and help cultivate a culture
                        of transformation that prepares your organization for the future impacts of technology.
                    </div>
                    <div class="services-more local-scroll wow fadeInUpShort" data-wow-delay=".3s">
                        <a href="#strategy" class="text-link">Learn More</a>
                    </div>
                </div>
            </div>

            <!-- Services Item -->
            <div class="col-sm-6 col-md-4 col-lg-4">
                <div class="services-item text-center wow fadeIn" data-wow-delay=".1s" data-wow-duration="1.5s">
                    <div class="services-icon">
